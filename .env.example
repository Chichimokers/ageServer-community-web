# AgeLANServer base URL. Set the address and port used by your local server.
AGE_SERVER_URL=https://127.0.0.1:443

# Prefer trusting the server's certificate via AGE_SERVER_CA_FILE.
# Set to true only on a trusted local network if you cannot provide its CA.
AGE_SERVER_TLS_INSECURE=false

# Optional path to the PEM CA/certificate used by the local AgeLANServer.
# AGE_SERVER_CA_FILE=./certs/ageserver-ca.pem
